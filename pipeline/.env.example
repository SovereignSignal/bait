# Postgres connection. Railway injects this. Local default when unset: sqlite:///./bait.sqlite
DATABASE_URL=
# The Graph gateway key (step 2 snapshot)
GRAPH_API_KEY=
# Claude (steps 3 classify, 4 what_line, 6 why_blurb)
ANTHROPIC_API_KEY=
# Optional enrichment and signal providers. No key = client skipped with a log line.
EXA_API_KEY=
PARALLEL_API_KEY=
# Activity step: pools whose trades are fetched per run (default 30)
ACTIVITY_POOLS=30
ACTIVITY_WASH_POOLS=10
GITHUB_TOKEN=
# Optional Blockscout API key (some instances bot-challenge anonymous requests)
BLOCKSCOUT_API_KEY=
# Not used by the pipeline yet (context tile lives in the web service)
BLOCKWORKS_API_KEY=
ENRICH_MAX=40
# A project enriched to an empty what_line is retried (same cap, after never-enriched projects) once this many days old.
ENRICH_RETRY_DAYS=7
# Step group: explorer creator lookups per night for grouped hooks without a registry deployer (0 disables).
DEPLOYER_LOOKUPS=200
# Hours a submitted Parallel run is polled before it is written off (default 48). Older run_ids become tombstones and the project is enriched without Parallel facts.
PARALLEL_RUN_MAX_AGE_H=
# Dev radar step (GitHub registry + repo search, Exa + Claude classification). Caps per run.
RADAR_REGISTRY_PAGES=3
RADAR_GITHUB_QUERIES=8
RADAR_EXA_QUERIES=6
RADAR_CLASSIFY_MAX=30
# On-chain indexer (python -m bait.indexer, Railway service "indexer"). Envio HyperSync token; without it the indexer only
# follows new Initialize logs over public RPCs on 10 chains (no backfill, no swaps).
HYPERSYNC_API_TOKEN=
INDEXER_INTERVAL=60
# Per-hook cap: v4_pools rows per hook (launchpads make one pool per coin); past it pools are counted. Late rows for pools
# past it need a priced swap >= INDEXER_LATE_INSERT_MIN_USD and stop at INDEXER_SAMPLED_POOLS_PER_HOOK; HyperSync calls per
# chain per loop to find them: INDEXER_POOL_LOOKUPS.
INDEXER_POOLS_PER_HOOK=2000
INDEXER_POOL_LOOKUPS=10
INDEXER_POOL_LOOKUPS_CATCHUP=3
INDEXER_LATE_INSERT_MIN_USD=10
INDEXER_SAMPLED_POOLS_PER_HOOK=1000
# Step onchain: unlisted hooks added per night (each can cost a Claude call in group), and max indexer staleness in hours.
ONCHAIN_MAX_NEW_HOOKS=500
ONCHAIN_MAX_STALE_HOURS=6
# Free, paced UTC/USD candle refresh for held-back pools with estimated closed days and exact positive swaps (0 disables).
ONCHAIN_CANDLE_REFRESH_CAP=10
DISK_LIMIT_GB=50
