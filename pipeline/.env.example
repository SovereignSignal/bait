# Postgres connection. Railway injects this. Local default when unset: sqlite:///./bait.sqlite
DATABASE_URL=
# The Graph gateway key (step 2 snapshot, Nansen LP address lookup in step 6)
GRAPH_API_KEY=
# Claude (steps 3 classify, 4 what_line, 6 why_blurb)
ANTHROPIC_API_KEY=
# Optional enrichment and signal providers. No key = client skipped with a log line.
EXA_API_KEY=
PARALLEL_API_KEY=
NANSEN_API_KEY=
# Set to 1 to use Nansen premium-labels (Smart Money / Fund tags, 500 credits per hit) instead of labels (100)
NANSEN_PREMIUM_LABELS=0
# Activity step: pools whose trades are fetched per run (default 30), Nansen label calls per run (credit cap,
# default 60), days before a labeled wallet is re-queried (default 14)
ACTIVITY_POOLS=30
NANSEN_MAX_ADDRESSES=10
NANSEN_RELABEL_DAYS=30
GITHUB_TOKEN=
# Optional Blockscout API key (some instances bot-challenge anonymous requests)
BLOCKSCOUT_API_KEY=
# Not used by the pipeline yet (context tile lives in the web service)
BLOCKWORKS_API_KEY=
NANSEN_MONTHLY_CREDITS=10000
ENRICH_MAX=40
