# Postgres connection. Railway injects this. Local default when unset: sqlite:///./bait.sqlite
DATABASE_URL=
# Steps to run, comma list, always in pipeline order (empty = all; --steps overrides it)
BAIT_STEPS=
# Log lines: json or text (pipeline and indexer)
BAIT_LOG_FORMAT=json
# The Graph gateway key (step 2 snapshot)
GRAPH_API_KEY=
# Keyless source (GeckoTerminal + public RPC) for chains without a subgraph or GRAPH_API_KEY; KEYLESS=0 disables it.
# Pages per sort per chain, pages of newest pools per chain, pools with 7d candles, seconds between keyless calls.
KEYLESS=1
KEYLESS_PAGES=4
KEYLESS_NEW_PAGES=2
KEYLESS_OHLCV_CAP=70
KEYLESS_SPACING=10
# Seconds per chain for finding unresolved pools' hooks in Initialize logs over public RPC
KEYLESS_FALLBACK_BUDGET=150
# Local dev only: a directory that keeps GeckoTerminal answers and serves them again on later runs (empty = no cache)
KEYLESS_CACHE_DIR=
# Optional CoinGecko paid-plan key: GeckoTerminal calls through pro-api.coingecko.com/api/v3/onchain at the plan's pace
# (COINGECKO_CALLS_PER_MIN, default 500 = Analyst). Unset = keyless GeckoTerminal, KEYLESS_SPACING apart.
COINGECKO_API_KEY=
COINGECKO_CALLS_PER_MIN=500
# Claude (group: classify the long tail; enrich: what_line; signals: why_blurb; radar: classify)
ANTHROPIC_API_KEY=
# Paid-call budgets in USD (bait/costs.py), all providers together: per UTC day, per rolling 30 days. 0 holds paid calls.
SPEND_DAILY_USD=3.00
SPEND_MONTHLY_USD=40.00
# Optional per-provider caps, checked as well (empty = none)
SPEND_DAILY_USD_ANTHROPIC=
SPEND_MONTHLY_USD_ANTHROPIC=
SPEND_DAILY_USD_EXA=
SPEND_MONTHLY_USD_EXA=
# Optional: Exa for the radar step's web searches. No key = client skipped with a log line.
EXA_API_KEY=
# Activity step: pools whose trades are fetched per run (default 30)
ACTIVITY_POOLS=30
ACTIVITY_WASH_POOLS=10
GITHUB_TOKEN=
# Optional Blockscout API key (some instances bot-challenge anonymous requests)
BLOCKSCOUT_API_KEY=
# Enrich step: projects given a Claude what_line per run, busiest first, live-pool projects only (default 20)
ENRICH_MAX=20
# A project enriched to an empty what_line is retried (same cap, after never-enriched projects) once this many days old.
ENRICH_RETRY_DAYS=7
# Step group: deployer lookups per night for grouped hooks without a registry deployer: Sourcify's creation-tx sender, then the chain's Blockscout (default 200; 0 disables).
DEPLOYER_LOOKUPS=200
# Step group: verified-source contract-name lookups per night for unlisted hooks (0 disables)
NAMES_MAX=400
# Step group: hooks whose bytecode template (code_shape) is read over free public RPC per run (0 disables)
SHAPE_MAX=3000
# Step group: wall-clock seconds for each public-RPC bytecode pass (code hashes and proxy status, then code shapes)
REHASH_BUDGET_S=120
# Step group: Claude Haiku classifications of long-tail hooks per run
GROUP_CLAUDE_MAX=100
# Signals step: free nightly status check of every published audit link; 404/410 links leave the badge (0 disables)
AUDIT_LINKS=1
# Audit links asked per night, and the check's wall-clock budget in seconds
AUDIT_LINKS_MAX=300
AUDIT_LINKS_BUDGET_S=180
# Dev radar step (GitHub registry + repo search, Exa + Claude classification). Caps per run.
RADAR_REGISTRY_PAGES=3
RADAR_GITHUB_QUERIES=8
RADAR_EXA_QUERIES=6
RADAR_CLASSIFY_MAX=30
# On-chain indexer (python -m bait.indexer, Railway service "indexer"). Envio HyperSync token; without it the indexer only
# follows new Initialize logs over public RPCs on 10 chains (no backfill, no swaps).
HYPERSYNC_API_TOKEN=
# Optional second token for the one-off `scan-pool-keys` backfill only (falls back to HYPERSYNC_API_TOKEN).
HYPERSYNC_API_TOKEN_SCAN=
INDEXER_INTERVAL=60
# Indexer chains (comma slugs or ids; empty = all) and tuning: HyperSync pages per chain per loop, hooked pools filtered
# by id server side, pool ids per Swap query in that mode, eth_getLogs windows per chain per loop in RPC mode.
INDEXER_CHAINS=
INDEXER_MAX_PAGES=40
INDEXER_TOPIC_FILTER_MAX=2000
INDEXER_TOPIC_CHUNK=500
INDEXER_RPC_MAX_WINDOWS=30
# Wall-clock seconds per HyperSync request (0 = no cap; at most 3600)
HYPERSYNC_DEADLINE=120
# Per-hook cap: v4_pools rows per hook (launchpads make one pool per coin); past it pools are counted. Late rows for pools
# past it need a priced swap >= INDEXER_LATE_INSERT_MIN_USD and stop at INDEXER_SAMPLED_POOLS_PER_HOOK; HyperSync calls per
# chain per loop to find them: INDEXER_POOL_LOOKUPS.
INDEXER_POOLS_PER_HOOK=2000
INDEXER_POOL_LOOKUPS=10
INDEXER_POOL_LOOKUPS_CATCHUP=3
INDEXER_LATE_INSERT_MIN_USD=10
INDEXER_SAMPLED_POOLS_PER_HOOK=1000
# Pool ids per HyperSync Initialize lookup for those pools
INDEXER_LOOKUP_CHUNK=2000
# Step onchain: unlisted hooks added per night (each can cost a Claude call in group), and max indexer staleness in hours.
ONCHAIN_MAX_NEW_HOOKS=500
ONCHAIN_MAX_STALE_HOURS=6
# Free, paced UTC/USD candle refresh for held-back pools with estimated closed days and exact positive swaps (0 disables).
ONCHAIN_CANDLE_REFRESH_CAP=10
DISK_LIMIT_GB=50
