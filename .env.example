# bait environment. Copy to .env for local dev; never commit .env.
# On Railway, set these as service variables (see railway/README.md). No values here.

# --- database and keys ---
# Postgres connection string. Railway injects it on the Postgres service; other services get it via ${{Postgres.DATABASE_URL}}. Unset locally = pipeline falls back to SQLite; web renders empty unless BAIT_FIXTURES=1.
DATABASE_URL=
# The Graph gateway API key for the per-chain Uniswap v4 subgraphs (pipeline step 2 snapshot).
GRAPH_API_KEY=
# Anthropic API key: Haiku 4.5 classification (group, radar), Sonnet 5.5 what_line (enrich) and why_blurb (signals). Optional; budget-capped by SPEND_DAILY_USD / SPEND_MONTHLY_USD.
ANTHROPIC_API_KEY=
# Exa search key: the radar step's web searches (hackathon, incubator, audit and launch posts). Optional; radar skips Exa when unset.
EXA_API_KEY=
# GitHub token: commit/star activity (alive signal) and the radar's registry and repo search (code search needs it). Optional; the hooklist download does not use it.
GITHUB_TOKEN=

# --- added by the service READMEs (pipeline/.env.example, web/.env.example) ---
# Optional Blockscout API key; some instances bot-challenge anonymous requests (code hashes, contract names and deployer lookups in group, verified source in enrich).
BLOCKSCOUT_API_KEY=
# Public origin for RSS links and OG metadata, no trailing slash. Web only. Local: http://localhost:3000; Railway: https://${RAILWAY_PUBLIC_DOMAIN}.
NEXT_PUBLIC_SITE_URL=

# --- paid-call budgets (pipeline/bait/costs.py), pipeline only ---
# USD for all paid calls in a UTC day (default 3.00). 0 holds every paid call; the free steps still run.
SPEND_DAILY_USD=
# USD for all paid calls in the last 30 days (default 40.00).
SPEND_MONTHLY_USD=
# Optional per-provider caps (Anthropic, Exa) checked as well, same windows (default: none).
SPEND_DAILY_USD_ANTHROPIC=
SPEND_MONTHLY_USD_ANTHROPIC=
SPEND_DAILY_USD_EXA=
SPEND_MONTHLY_USD_EXA=

# --- nightly run (python -m bait run), pipeline only ---
# Steps to run, comma list, always in pipeline order (default all; --steps overrides it).
BAIT_STEPS=
# Log lines as json (default) or text, for the pipeline and the indexer.
BAIT_LOG_FORMAT=

# --- keyless source (GeckoTerminal + public RPC), used for chains without a subgraph or GRAPH_API_KEY ---
# 0 disables it. Defaults: KEYLESS_PAGES=4 pages per sort per chain, KEYLESS_OHLCV_CAP=70 pools with 7d series,
# KEYLESS_SPACING=10 seconds between GeckoTerminal calls (free tier throttles near 5/min).
KEYLESS=
KEYLESS_PAGES=
KEYLESS_OHLCV_CAP=
KEYLESS_SPACING=
# Pages of GeckoTerminal's newest pools read per chain (default 2).
KEYLESS_NEW_PAGES=
# Seconds per chain for finding unresolved pools' hooks in Initialize logs over public RPC (default 150).
KEYLESS_FALLBACK_BUDGET=
# Local dev only: a directory that keeps GeckoTerminal answers and serves them again on later runs (default: unset, no cache).
KEYLESS_CACHE_DIR=
# Optional CoinGecko paid-plan key, pipeline only. Set: GeckoTerminal calls go to pro-api.coingecko.com/api/v3/onchain with
# the key in the x-cg-pro-api-key header, 60/COINGECKO_CALLS_PER_MIN s apart (default 500, the Analyst plan) instead of
# KEYLESS_SPACING; a refused key turns the rest of the run keyless. Unset: keyless GeckoTerminal, unchanged.
COINGECKO_API_KEY=
COINGECKO_CALLS_PER_MIN=

# --- activity step (who trades each hooked pool), pipeline only ---
# Pools whose recent trades are fetched from GeckoTerminal per run (top by 24h volume, wash pools excluded). Default 30.
ACTIVITY_POOLS=
# 24h-wash candidates whose trades are also fetched (symmetric-trader check), default 10.
ACTIVITY_WASH_POOLS=

# --- group step (hooks into projects), pipeline only ---
# Verified-source contract-name lookups per night for unlisted hooks (default 400; 0 disables).
NAMES_MAX=
# Hooks whose bytecode template (code_shape) is read over free public RPC per run (default 3000; 0 disables).
SHAPE_MAX=
# Wall-clock seconds for each public-RPC bytecode pass: code hashes and proxy status, then code shapes (default 120).
REHASH_BUDGET_S=
# Claude Haiku classifications of long-tail hooks per run (default 100).
GROUP_CLAUDE_MAX=
# Deployer lookups per night for grouped hooks without a registry deployer: Sourcify's creation-tx sender, then the
# chain's Blockscout (default 200; 0 disables).
DEPLOYER_LOOKUPS=

# --- enrich step (the what_line), pipeline only ---
# Projects given a Claude what_line per run, busiest first, live-pool projects only (default 20).
ENRICH_MAX=
# Days before a project enriched to an empty what_line is tried again (default 7).
ENRICH_RETRY_DAYS=

# --- signals step: audit links (pipeline/bait/audit_links.py), pipeline only ---
# Free nightly status check of every published audit link; a 404/410 link leaves the "Audit linked" badge. 0 disables it.
AUDIT_LINKS=
# Links asked per night (default 300) and the check's wall-clock budget in seconds (default 180).
AUDIT_LINKS_MAX=
AUDIT_LINKS_BUDGET_S=

# --- radar step (what is being built: hooklist submissions, GitHub repos, Exa web results classified by Claude), pipeline only ---
# Defaults: RADAR_REGISTRY_PAGES=3 (pages of 100 hooklist issues/PRs, newest first), RADAR_GITHUB_QUERIES=8 (search calls),
# RADAR_EXA_QUERIES=6, RADAR_CLASSIFY_MAX=30 (Claude Haiku calls). GITHUB_TOKEN enables code search; without it the registry
# and repo search use the anonymous API unless KEYLESS=0.
RADAR_REGISTRY_PAGES=
RADAR_GITHUB_QUERIES=
RADAR_EXA_QUERIES=
RADAR_CLASSIFY_MAX=

# --- on-chain indexer (python -m bait.indexer, Railway service "indexer") + nightly step "onchain" ---
# Envio HyperSync API token (https://envio.dev/app/api-tokens). Without it the indexer only follows new Initialize logs over
# public RPCs on 10 chains: no history, no swaps/wallets/volume, no Monad/World Chain/Soneium/MegaETH/Celo/Zora.
HYPERSYNC_API_TOKEN=
# Optional second Envio token, read only by the one-off `python -m bait.indexer scan-pool-keys` (falls back to HYPERSYNC_API_TOKEN),
# so the backfill does not share the live indexer's rate limit. Delete it after the scan (railway/README.md).
HYPERSYNC_API_TOKEN_SCAN=
# Seconds per indexer loop (default 60). INDEXER_CHAINS limits chains (comma slugs or ids). Tuning: INDEXER_MAX_PAGES=40,
# INDEXER_TOPIC_FILTER_MAX=2000, INDEXER_TOPIC_CHUNK=500, INDEXER_RPC_MAX_WINDOWS=30.
INDEXER_INTERVAL=
INDEXER_CHAINS=
INDEXER_MAX_PAGES=
INDEXER_TOPIC_FILTER_MAX=
INDEXER_TOPIC_CHUNK=
INDEXER_RPC_MAX_WINDOWS=
# Wall-clock seconds per HyperSync request, 0 to 3600 (default 120; 0 = no cap).
HYPERSYNC_DEADLINE=
# Per-hook cap on stored pools (default 2000; 0 = no new caps). Pools past it are counted in hook_pool_counts; one that swaps
# becomes a row on a priced swap >= INDEXER_LATE_INSERT_MIN_USD (10), at most INDEXER_SAMPLED_POOLS_PER_HOOK (1000) per hook;
# the rest's usage stays on the hook. INDEXER_POOL_LOOKUPS (10): HyperSync calls per chain per loop to find such pools.
INDEXER_POOLS_PER_HOOK=
INDEXER_POOL_LOOKUPS=
# Multiplier for INDEXER_POOL_LOOKUPS while a chain's swap cursor is more than 100K blocks behind (default 3).
INDEXER_POOL_LOOKUPS_CATCHUP=
INDEXER_LATE_INSERT_MIN_USD=
INDEXER_SAMPLED_POOLS_PER_HOOK=
# Pool ids per HyperSync Initialize lookup for those pools (default 2000).
INDEXER_LOOKUP_CHUNK=
# Step onchain: unlisted hooks added per night (default 500) and how stale indexer_state may be before usage is not used (6 h).
ONCHAIN_MAX_NEW_HOOKS=
ONCHAIN_MAX_STALE_HOURS=
# Step onchain: free, paced GeckoTerminal candle fetches per night for held-back pools whose closed days are estimated
# but have exact positive swaps (default 10; 0 disables).
ONCHAIN_CANDLE_REFRESH_CAP=
# Postgres volume size in GB for the nightly disk line (default 50); warns at 60%.
DISK_LIMIT_GB=

# --- web only ---
# Milliseconds before a database query fails and is logged instead of holding the page open (default 20000).
BAIT_QUERY_TIMEOUT_MS=
# Uniswap's published routing allowlist and denylist, fetched in the background (default on). 0 turns them off: routing
# then uses the automatic rule alone.
BAIT_ROUTING_LISTS=
# Local UI dev only: 1 serves the sample dataset (web/src/fixtures/sample.ts) when DATABASE_URL is unset. Never set on Railway.
BAIT_FIXTURES=
