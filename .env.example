# hookfeed environment. Copy to .env for local dev; never commit .env.
# On Railway, set these as service variables (see railway/README.md). No values here.

# --- DESIGN.md "Env" list ---
# Postgres connection string. Railway injects it on the Postgres service; other services get it via ${{Postgres.DATABASE_URL}}. Unset locally = pipeline falls back to SQLite; web renders empty unless HOOKFEED_FIXTURES=1.
DATABASE_URL=
# The Graph gateway API key for the per-chain Uniswap v4 subgraphs (pipeline step 2 snapshot; also Nansen address lookup in step 6).
GRAPH_API_KEY=
# Anthropic API key: Haiku 4.5 long-tail classification (step 3), Sonnet 5.5 what_line + why_blurb (steps 4, 6).
ANTHROPIC_API_KEY=
# Exa search key: 30-day receipts for New / Trending projects (step 6). Optional; client skipped when unset.
EXA_API_KEY=
# Parallel task API key: one-time enrichment per new project (team, site, github, X, audit). Optional.
PARALLEL_API_KEY=
# Nansen API key: smart-money labels on top pools' LPs / swappers (step 6). Optional; skipped on Unichain + Ink regardless.
NANSEN_API_KEY=
# GitHub token for commits / stars (alive signal) and raw hooklist.json fetch; raises the unauthenticated rate limit. Optional.
GITHUB_TOKEN=
# Blockworks API key for the context tiles (Uniswap DEX volume, Unichain chain metrics). Web service; unused by the pipeline today.
BLOCKWORKS_API_KEY=

# --- added by the service READMEs (pipeline/.env.example, web/.env.example) ---
# Set to 1 to use Nansen premium-labels (Smart Money / Fund tags, 500 credits per hit) instead of labels (100). Pipeline only.
NANSEN_PREMIUM_LABELS=
# Optional Blockscout API key; some instances bot-challenge anonymous requests (source-code lookup, step 3/4).
BLOCKSCOUT_API_KEY=
# Public origin for RSS links and OG metadata, no trailing slash. Web only. Local: http://localhost:3000; Railway: https://${RAILWAY_PUBLIC_DOMAIN}.
NEXT_PUBLIC_SITE_URL=
