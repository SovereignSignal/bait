# Postgres connection string. When unset, pages render empty (see BAIT_FIXTURES).
DATABASE_URL=
# Public origin used for RSS links and OG metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Milliseconds before a database query fails and is logged instead of holding the page open.
BAIT_QUERY_TIMEOUT_MS=20000
# Uniswap's published routing allowlist and denylist, fetched in the background. 0 turns them off: routing then uses
# the automatic rule alone.
BAIT_ROUTING_LISTS=1

# Local UI dev only: set to 1 to serve src/fixtures/sample.ts when DATABASE_URL is unset. Never set on Railway.
BAIT_FIXTURES=
